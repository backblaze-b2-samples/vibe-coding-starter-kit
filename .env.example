# Backblaze B2 (required)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# The region in your bucket's S3 endpoint, e.g. s3.<region>.backblazeb2.com.
# The endpoint itself is derived from it, so there is no endpoint variable.
B2_REGION=your-b2-region

# Optional — public base URL for objects, when the bucket is public.
# B2_PUBLIC_URL_BASE=https://your-bucket.s3.us-west-004.backblazeb2.com

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K005EXAMPLE_NOT_A_REAL_APP_KEY
# B2_BUCKET_NAME=my-app-uploads
# B2_REGION=us-west-004

# Frontend → API base URL. Defaults to http://localhost:8000 for local dev;
# set this to the deployed API origin in production (Next.js inlines it at
# build time, so it must be present when `pnpm build` runs).
# NEXT_PUBLIC_API_URL=https://your-api.example.com
